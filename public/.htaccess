# SPA routing for the Sales Coordinator app on Apache/Hostinger static hosting.
# Any deep link (e.g. /dashboard, /leads) is served by index.html so React Router
# can handle it, instead of returning a 404.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Small caching + gzip win for the static assets
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
